{
  "name": "aruma-editor",
  "version": "0.4.0",
  "description": "A reliable local-first Markdown writing desk for Aruma and Mizuki blogs.",
  "author": "Heronesukun",
  "private": true,
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/article-document.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern desktop-dist --ignore-pattern release",
    "desktop:build": "vite build --config desktop/vite.config.ts",
    "desktop:start": "npm run desktop:build && electron .",
    "desktop:smoke": "npm run desktop:build && electron . --smoke-test",
    "release:win": "npm run desktop:build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "js-yaml": "^5.2.2",
    "lucide-react": "^1.28.0",
    "marked": "^18.0.7",
    "next": "16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "postcss": "8.5.18",
    "sharp": "0.35.0"
  },
  "build": {
    "appId": "top.heronesukun.aruma-editor",
    "productName": "Aruma Editor",
    "artifactName": "ArumaEditor-${version}-win-${arch}.${ext}",
    "asar": true,
    "compression": "maximum",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop-dist/**/*",
      "build-resources/icon.ico",
      "package.json",
      "LICENSE",
      "!node_modules/**/*"
    ],
    "win": {
      "icon": "build-resources/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "type": "module"
}
